      m_Calls: []
  m_text: "PRODUCTOR\r\nAdri\xE1n Valero Fern\xE1ndez\r\n\r\nDISE\xD1ADORES\r\nAdri\xE1n
    Valero Fern\xE1ndez\r\nNoelia Bocardo \r\n\r\nARTISTAS\r\nGerard De la Torre
    Perpiny\xE0\r\nJoel Pacheco Ib\xE1\xF1ez\r\nArnau Segu\xED Borrell\r\n\r\nPROGRAMADORES\r\nEric
    Fenollar\r\nEnric Guinovart \r\n\r\nSONIDO\r\nH\xE9ctor Moreno Navarro\r\nAlbert
    del Rey \r\nXavi Sol\xE9\r\nJoana Roy\r\nJordi Ros Torra\r\nLuc\xEDa Larrosa
    Corral\r\nBruc Mingo Mart\xEDnez\r\n\r\nPROFESORES\r\nDaniel Candil Gil-Ortega\r\nJavier
    Untoria Zu\xF1iga\r\nRafael Gonz\xE1lez Fern\xE1ndez\r\n\r\nTESTERS\r\nPaula
    Romero \r\nAntero Herrera\r\nMar\xEDa Alemany\r\nF\xE9lix Turro\r\nAlbert Bitzy\r\nGeorgina
    Vidal\r\n\r\nOTROS PROVEEDORES\r\nAureDevGames\r\nrastataper\r\nInfraction -
    No Copyright music\r\nDjfede \n\n\n\r\n\r\nAGRADECIMIENTO ESPECIAL\r\nAnna Gargallo
    Soler\r\nAntony Starr\r\nBill Finger\r\nBob Kane\r\nDarick Robertson\r\nDave
    Gibbons\r\nFrank Miller\r\nGarth Ennis\r\nHirohiko Araki\r\nIzan Diaz\r\nJerry
    Siegel\r\nJoan Pons Lopez\r\nJoe Shuster\r\nJohn Higgins\r\nKentaro Miura\r\nMario
    Sanchez\r\nMike Mignola\r\nOVERKILL Software\r\nSonny John\r\nStan Lee\r\nSteve
    Ditko\r\n3ds Max\r\n\n\n\n\n\n\r\n\r\nMUCHAS GRACIAS POR JUGAR A NUESTRO JUEGO.
    ESPERAMOS QUE LO HAYAS DISFRUTADO MUCHO.\r\n"
  m_isRightToLeft: 0
