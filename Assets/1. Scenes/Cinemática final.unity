  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PRODUCTOR\r\nAdri\xE1n Valero Fern\xE1ndez\r\n\r\nDISE\xD1ADORES\r\nAdri\xE1n
    Valero Fern\xE1ndez\r\nNoelia Bocardo \r\n\r\nARTISTAS\r\nGerard De la Torre
    \r\nJoel Pacheco Ib\xE1\xF1ez\r\nArnau Segu\xED Borrell\r\n\r\nPROGRAMADORES\r\nEric
    Fenollar\r\nEnric Guinovart \r\n\r\nSONIDO\r\nH\xE9ctor Moreno Navarro\r\nAlbert
    del Rey \r\nXavi Sol\xE9\r\nJoana \r\nJordi Ros Torra\r\nLuc\xEDa Larrosa Corral\r\nBruc
    Mingo Mart\xEDnez\r\n\r\nPROFESORES\r\nDaniel Candil Gil-Ortega\r\nJavier Untoria
    Zu\xF1iga\r\nRafael Gonz\xE1lez Fern\xE1ndez\r\n\r\nTESTERS\r\nPaula Romero \r\nAntero
    \r\nMar\xEDa Alemany\r\nF\xE9lix\r\nGeorgina Vidal\r\n\r\nOTROS PROVEEDORES\r\nAureDevGames\r\nrastataper\r\n\r\n\n\n\nAGRADECIMIENTO
    ESPECIAL\r\nAnna Gargallo Soler\r\nIzan Diaz\r\nAntony Starr\r\nMike Mignola\r\nDave
    Gibbons\r\nJohn Higgins\r\nJerry Siegel\r\nJoe Shuster\r\nBob Kane\r\nBill Finger\r\nStan
    Lee\r\nSteve Ditko\r\nFrank Miller\r\nGarth Ennis\r\nDarick Robertson\r\nHirohiko
    Araki\r\nSonny John\r\nOVERKILL Software\r\n\r\n\r\nMUCHAS GRACIAS POR JUGAR
    A NUESTRO JUEGO. ESPERAMOS QUE LO HAYAS DISFRUTADO MUCHO.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6f43bb913c7b0c44faea81454d216bb7, type: 2}
  m_sharedMaterial: {fileID: 8610938632409797074, guid: 6f43bb913c7b0c44faea81454d216bb7, type: 2}
