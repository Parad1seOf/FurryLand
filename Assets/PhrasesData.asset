%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 252cc06dbce7d0448842705fc88acf1f, type: 3}
  m_Name: PhrasesData
  m_EditorClassIdentifier: Assembly-CSharp::PhrasesData
  phraseslist:
  - id: Start_Game
    text: 'Infiltrarse,

      Usar sus mismos recursos,

      Cerrar entradas,

      Reventarles
      hasta que la estatua forrada en oro arda.'
  - id: Enter_ForbiddenArea
    text: Espero que nadie me vea pisar las flores. Hay dictaduras menos estrictas.
  - id: Wood_Pickup
    text: "Con su madera cerrar\xE9 sus propias puertas y nada ni nadie me parar\xE1."
  - id: Ammo_Pickup
    text: "Munici\xF3n... qu\xE9 buen recibimiento."
  - id: Parkour_Tip
    text: "Es un p\xE1jaro, es un avi\xF3n, no soy yo salt\xE1ndoles por encima de
      sus caravanas.\n"
  - id: Block_Door
    text: "Eso deber\xEDa entretenerlos un rato."
  - id: Break_Block
    text: "Genial, la marrera se ha destruido, m\xE1s invitados."
  - id: Weapon_Stealth
    text: "Oler\xE1n mi p\xF3lvora."
  - id: Start_Phase2
    text: "Es la hora de la p\xF3lvora.\n"
  - id: C4_Placed
    text: "Un gran poder conlleva una gran explosi\xF3n."
  - id: C4_Explode
    text: "\xA1Excelsior!"
  - id: C4_Checkpoint
    text: "Qu\xE9 cagarro, he de colocar otro C4.\n"
  - id: Elephant_Spawns
    text: "\xBFQu\xE9 demonios es ese ruido?"
  - id: Elephant_Watering
    text: "Ya lo que faltaba, ahora la carga retrocede, alguien deber\xE1 pararle
      los pies a ese gordo."
  - id: Low_Health
    text: No he llegado tan lejos para caer ahora.
  - id: Constitucion_Spawned
    text: "Al fin ha aparecido la maldita constituci\xF3n."
  - id: FurryConstitucion_Pickup
    text: "\xA1Hay que salir por patas!\n\xBFD\xF3nde estaba la maldita entrada?"
  - id: Exit_Approach
    text: "\xA1Un \xFAltimo sprint! Ya se huele la libertad."
